<?xml version="1.0"?>
<ruleset name="Meilisearch">
	<description>Coding standard for the Meilisearch WordPress plugin.</description>

	<file>meilisearch.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>/tests/integration/plugins/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.9"/>

	<rule ref="WordPress">
		<!-- PSR-4 file names (src/Api/Client.php). -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short arrays are allowed. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Exception messages are data; they are escaped where they are displayed. -->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="meilisearch"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="meilisearch"/>
				<element value="Meilisearch\WordPress"/>
			</property>
		</properties>
	</rule>

	<!-- Tests: no docblock requirements; WordPress class doubles and test globals are unprefixed. -->
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
